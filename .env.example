# ==============================================================================
# CONFIGURAÇÃO DO SITE DO CANDIDATO / MANDATO
# ==============================================================================

# ID ou Slug do site deste deploy no banco de dados
VITE_SITE_ID=site-a-uuid-carlos

# Credenciais do Supabase (Opcional - se não configurado, roda em modo local com seed)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica
